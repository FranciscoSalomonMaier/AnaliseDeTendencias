FRONTEND_URL=http://localhost:5173

YOUTUBE_V3_API_KEY=

REDDIT_ACCESS_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AI_ANALYSIS_LIMIT=10
OPENAI_TIMEOUT_MS=120000
AI_ANALYSIS_CACHE_TTL_SECONDS=1800
DATABASE_URL=postgresql://trend_app:trend_dev_change_me@127.0.0.1:5433/trend_analysis

# Semantic topics: background processing; no AI calls from ranking GET.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TOPIC_CLUSTER_SIMILARITY_THRESHOLD=0.75
# Optional: defaults to the existing OPENAI_MODEL
# OPENAI_TOPIC_NAMING_MODEL=

# Visual assets. Reuses OPENAI_API_KEY; no browser keys.
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=medium
IMAGE_CONCURRENCY=2
IMAGE_MAX_QUEUED=200
IMAGE_TIMEOUT_MS=180000
# Relative to the API working directory; mount/back up this directory.
CONTENT_STORAGE_PATH=storage

# Narration. Uses the same OPENAI_API_KEY. Samples are generated only on explicit action.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_DEFAULT_VOICE=cedar
TTS_OUTPUT_FORMAT=mp3
TTS_MAX_CONCURRENCY=2
TTS_MAX_TEXT_LENGTH=4096
TTS_MAX_QUEUED=200
TTS_TIMEOUT_MS=120000

# Video MVP: local CPU render, no OpenAI calls. Defaults to packaged FFmpeg/FFprobe.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_RENDER_WIDTH=1920
VIDEO_RENDER_HEIGHT=1080
VIDEO_RENDER_FPS=30
VIDEO_RENDER_CODEC=libx264
VIDEO_RENDER_AUDIO_CODEC=aac
VIDEO_RENDER_CRF=23
VIDEO_RENDER_PADDING_MS=300
VIDEO_RENDER_MOTION=true
VIDEO_RENDER_NORMALIZE_AUDIO=true
VIDEO_RENDER_MAX_CONCURRENCY=1
VIDEO_RENDER_THREADS=2
VIDEO_RENDER_MAX_QUEUED=20
VIDEO_RENDER_MAX_DURATION_SECONDS=1800
VIDEO_RENDER_TIMEOUT_MS=1800000
VIDEO_RENDER_MIN_FREE_MB=1024
VIDEO_RENDER_MAX_FILE_MB=2048
VIDEO_RENDER_TEMP_DIR=storage/render-tmp

# Subtitle transcription uses OPENAI_API_KEY and whisper-1 with real timestamps.
# Single worker; minimum gap between requests. Set 21000 for a 3 RPM account.
SUBTITLE_REQUEST_INTERVAL_MS=1000

# Acesso local ao estúdio. Configure uma chave forte (mínimo recomendado: 32 caracteres).
# Sem chave, a preparação de publicação fica desabilitada.
CONTENT_ACCESS_KEY=
CONTENT_OWNER_ID=local-owner

# Etapa 9 — publicação oficial no YouTube (OAuth, somente backend)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/youtube-publishing/oauth/callback
# 32 bytes aleatórios em base64, nunca commitar a chave real
YOUTUBE_ENCRYPTION_KEY=
YOUTUBE_ENCRYPTION_KEY_ID=v1
# JSON opcional com chaves anteriores por ID, para rotação
YOUTUBE_PREVIOUS_ENCRYPTION_KEYS=
YOUTUBE_UPLOADS_ENABLED=false
YOUTUBE_PUBLIC_PUBLICATION_ENABLED=false

# Optional intelligent editing. Analysis only starts on explicit user action.
# Text planner inherits OPENAI_MODEL when empty.
INTELLIGENT_EDITING_MODEL=
# Explicitly select an image-input + structured-output capable model to enable vision.
# Empty: narrative analysis + safe static framing, no visual API calls.
INTELLIGENT_EDITING_VISUAL_MODEL=
INTELLIGENT_EDITING_MAX_SCENES=40

# Video Remix discovery uses the existing YOUTUBE_V3_API_KEY (server only).
VIDEO_REMIX_UPLOAD_MAX_MB=250
VIDEO_REMIX_UPLOAD_TEMP_DIR=storage/remix-upload-tmp
VIDEO_REMIX_SEARCH_PER_MINUTE=10
# Optional FFPROBE_PATH is shared with the existing media infrastructure.

# Video Remix — análise visual (Etapa 3). Configure explicitamente um modelo com visão e Structured Outputs.
VIDEO_REMIX_ANALYSIS_MODEL=
VIDEO_REMIX_ANALYSIS_TEMP_DIR=storage/remix-analysis-tmp
VIDEO_REMIX_ECONOMIC_MAX_FRAMES=45
VIDEO_REMIX_ECONOMIC_MAX_SEGMENTS=15
VIDEO_REMIX_ECONOMIC_INTERVAL_SECONDS=15
VIDEO_REMIX_ECONOMIC_FRAMES_PER_SEGMENT=3
VIDEO_REMIX_ECONOMIC_MAX_DURATION_SECONDS=600
VIDEO_REMIX_ECONOMIC_FRAME_EDGE=384
VIDEO_REMIX_DETAILED_MAX_FRAMES=120
VIDEO_REMIX_DETAILED_MAX_SEGMENTS=40
VIDEO_REMIX_DETAILED_INTERVAL_SECONDS=8
VIDEO_REMIX_DETAILED_FRAMES_PER_SEGMENT=3
VIDEO_REMIX_DETAILED_MAX_DURATION_SECONDS=1200
VIDEO_REMIX_DETAILED_FRAME_EDGE=768
VIDEO_REMIX_DETECT_CUTS=true
VIDEO_REMIX_CUT_THRESHOLD=0.3
VIDEO_REMIX_MIN_SEGMENT_SECONDS=2
VIDEO_REMIX_RELEVANCE_BANDS=40,70,90
VIDEO_REMIX_ANALYSIS_MAX_OUTPUT_TOKENS=2500
# Valores opcionais: preços por milhão de tokens e teto de tokens por imagem do modelo escolhido.
# Deixe vazios para não apresentar estimativas financeiras sem base.
VIDEO_REMIX_ANALYSIS_INPUT_USD_PER_MILLION=
VIDEO_REMIX_ANALYSIS_OUTPUT_USD_PER_MILLION=
VIDEO_REMIX_ANALYSIS_IMAGE_TOKEN_UPPER_BOUND=
VIDEO_REMIX_ANALYSIS_MAX_USD=
