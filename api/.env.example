FRONTEND_URL=http://localhost:5173

YOUTUBE_V3_API_KEY=

REDDIT_ACCESS_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AI_ANALYSIS_LIMIT=10
OPENAI_TIMEOUT_MS=120000
AI_ANALYSIS_CACHE_TTL_SECONDS=1800
DATABASE_URL=postgresql://trend_app:trend_dev_change_me@127.0.0.1:5433/trend_analysis

# Semantic topics: background processing; no AI calls from ranking GET.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TOPIC_CLUSTER_SIMILARITY_THRESHOLD=0.75
# Optional: defaults to the existing OPENAI_MODEL
# OPENAI_TOPIC_NAMING_MODEL=

# Visual assets. Reuses OPENAI_API_KEY; no browser keys.
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=medium
IMAGE_CONCURRENCY=2
IMAGE_MAX_QUEUED=200
IMAGE_TIMEOUT_MS=180000
# Relative to the API working directory; mount/back up this directory.
CONTENT_STORAGE_PATH=storage

# Narration. Uses the same OPENAI_API_KEY. Samples are generated only on explicit action.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_DEFAULT_VOICE=cedar
TTS_OUTPUT_FORMAT=mp3
TTS_MAX_CONCURRENCY=2
TTS_MAX_TEXT_LENGTH=4096
TTS_MAX_QUEUED=200
TTS_TIMEOUT_MS=120000

# Video MVP: local CPU render, no OpenAI calls. Defaults to packaged FFmpeg/FFprobe.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_RENDER_WIDTH=1920
VIDEO_RENDER_HEIGHT=1080
VIDEO_RENDER_FPS=30
VIDEO_RENDER_CODEC=libx264
VIDEO_RENDER_AUDIO_CODEC=aac
VIDEO_RENDER_CRF=23
VIDEO_RENDER_PADDING_MS=300
VIDEO_RENDER_MOTION=true
VIDEO_RENDER_NORMALIZE_AUDIO=true
VIDEO_RENDER_MAX_CONCURRENCY=1
VIDEO_RENDER_THREADS=2
VIDEO_RENDER_MAX_QUEUED=20
VIDEO_RENDER_MAX_DURATION_SECONDS=1800
VIDEO_RENDER_TIMEOUT_MS=1800000
VIDEO_RENDER_MIN_FREE_MB=1024
VIDEO_RENDER_MAX_FILE_MB=2048
VIDEO_RENDER_TEMP_DIR=storage/render-tmp
